# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Supabase Dashboard > Project Settings > API). O anon key é público por design,
# mas mesmo assim não faça commit do ".env.local" (ele já está no .gitignore).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui

# Opcional — só necessário pra rodar a suite de testes E2E (npm run test:e2e).
# Crie um usuário staff dedicado só pra isso (não uma pessoa real) e preencha aqui.
E2E_STAFF_EMAIL=e2e-staff@seudominio.local
E2E_STAFF_PASSWORD=
